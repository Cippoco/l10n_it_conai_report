<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Wizard: solo filtri + bottone -->
  <record id="view_conai_kg_report_wizard_form" model="ir.ui.view">
    <field name="name">conai.kg.report.wizard.form</field>
    <field name="model">conai.kg.report.wizard</field>
    <field name="arch" type="xml">
      <form string="Report CONAI Kg">
        <group>
          <field name="company_id"/>
          <field name="date_from"/>
          <field name="date_to"/>
        </group>

        <footer>
          <button name="action_generate" type="object" string="Genera Report" class="btn-primary"/>
          <button string="Chiudi" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Tree delle righe report (raggruppabile per fascia) -->
  <record id="view_conai_kg_report_line_tree" model="ir.ui.view">
    <field name="name">conai.kg.report.line.tree</field>
    <field name="model">conai.kg.report.line</field>
    <field name="arch" type="xml">
      <tree default_group_by="fascia_id">
        <field name="fascia_id"/>
        <field name="partner_id"/>
        <field name="kg_conai" sum="Kg CONAI"/>
        <field name="kg_esenzione" sum="Kg Esenzione"/>
        <field name="kg_assoggettati" sum="Kg Assoggettati"/>
        <field name="amount" sum="Tot Importo"/>
      </tree>
    </field>
  </record>

  <!-- Azione: apre il wizard -->
  <record id="action_conai_kg_report_wizard" model="ir.actions.act_window">
    <field name="name">Report CONAI Kg</field>
    <field name="res_model">conai.kg.report.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- Menu -->
  <menuitem id="menu_conai_kg_report_root"
            name="CONAI"
            parent="account.menu_finance_reports"
            sequence="60"/>
  <menuitem id="menu_conai_kg_report"
            name="Report Kg (Fascia/Cliente)"
            parent="menu_conai_kg_report_root"
            action="action_conai_kg_report_wizard"
            sequence="10"/>

</odoo>